# WordPress-Inhalte (Plugins, Themes, Uploads): PHP wird nie direkt über die URL ausgeführt – nur über die CMS-Laufzeit (cms/wp).
# Bilder, CSS und JavaScript bleiben abrufbar.
<FilesMatch "\.(php[0-9]?|phtml|phar|pht|inc)$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes

# Schriften dürfen auch vom abgeschotteten Editor-Rahmen (ohne Herkunft) geladen werden
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2?|ttf|otf|eot)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
